# Compiled output
/target/
**/target/

# Node / frontend
node_modules/
apps/desktop/node_modules/
dist/
apps/desktop/dist/
apps/desktop/.vite/

# Tauri build artefacts (keep src-tauri/gen for version control if desired,
# but binaries are large — exclude them)
apps/desktop/src-tauri/target/
apps/desktop/src-tauri/WixTools/

# Cargo lock files — keep the workspace one; exclude crate-level ones
# (workspace Cargo.lock is intentionally tracked for reproducible builds)

# Environment / secrets
.env
.env.*
*.pem
*.key

# Editor / IDE
.idea/
.vscode/settings.json
*.swp
*.swo
.DS_Store
Thumbs.db
